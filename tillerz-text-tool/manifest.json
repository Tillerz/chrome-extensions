{
  "manifest_version": 3,
  "name": "Tillerz Text Tool (3T)",
  "version": "1.0",
  "description": "Highlight saved keywords in pastel colors on every page. Improve readability: font, spacing, colors and columns.",
  "permissions": ["contextMenus", "storage", "fontSettings"],
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": { "default_title": "Text Marker (click to toggle)" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
